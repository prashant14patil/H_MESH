# .env.example
# -------------
# Copy this file to .env and fill in the values before running the application.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
#
# NEVER commit .env to version control. It is listed in .gitignore.
#
# This is the LOCAL GPU version of the Tanita Human Digital Twin POC.
# There is NO Google Colab, Flask tunnel, or ngrok configuration here —
# HMR2 inference runs directly in this backend process.

# ── Local HMR2 Model ─────────────────────────────────────────────────────────
# Path to the cloned 4D-Humans repo.
# Run `python scripts/download_models.py` to set this up automatically;
# it will print the correct value to paste here.
HMR2_REPO_PATH=models/4D-Humans

# Path to the HMR2 checkpoint (.ckpt) file.
# Also printed by scripts/download_models.py after it finishes.
HMR2_CHECKPOINT=

# Device to run inference on: "cuda", "cpu", or "auto" (default: auto —
# uses CUDA if a GPU is detected, otherwise falls back to CPU).
DEVICE=auto

# Whether to attempt loading the detectron2/ViTDet person detector.
# Set to "false" to always use the full-image fallback (recommended on
# Windows, where building detectron2 from source is difficult).
# If set to "true" but detectron2 isn't installed, the code falls back
# automatically anyway — this flag just skips the attempt entirely.
USE_DETECTRON2=false

# ── Local Backend ────────────────────────────────────────────────────────────
# Port on which the FastAPI backend listens.
# Used by: uvicorn backend.main:app --port $BACKEND_PORT
BACKEND_PORT=8000

# ── Local Frontend (React / Vite) ────────────────────────────────────────────
# Base URL of the FastAPI backend as seen by the React app.
# When running `npm run dev` the Vite proxy forwards /api and /health to
# http://localhost:8000 automatically, so you can leave this blank.
VITE_API_BASE_URL=

# ── Image Upload Limits ──────────────────────────────────────────────────────
# Maximum allowed upload size in megabytes.
MAX_UPLOAD_SIZE_MB=10

# ── Mesh Storage ─────────────────────────────────────────────────────────────
# Local directory where generated OBJ meshes are written by the inference
# engine. The directory is created automatically if it does not exist.
MESH_OUTPUT_DIR=outputs/meshes

# ── 360 Video Capture / Frame Extraction (Module 1 & 2) ──────────────────────
# Maximum allowed video upload size in megabytes.
MAX_VIDEO_SIZE_MB=200

# Local directory where uploaded videos and extracted frames are stored.
# The directory is created automatically if it does not exist.
CAPTURE_OUTPUT_DIR=data/captures

# Desired number of representative frames to extract per video
# (recommended range: 24-36 for a full 360 rotation). Candidate
# timestamps are sampled evenly across the video's REAL measured
# duration (not raw frame index), so this works even for WebM files
# with unreliable FPS/frame-count metadata (see video_processor.py).
TARGET_FRAME_COUNT=30

# Hard cap on the number of ACCEPTED frames written to disk, even if
# more candidate timestamps would otherwise qualify. Defaults to
# TARGET_FRAME_COUNT if unset.
MAX_EXTRACTED_FRAMES=30

# Minimum time (seconds) that must elapse between two ACCEPTED frames,
# independent of the sampling-interval math. Guards against clustering
# near-identical timestamps when a video's duration is very short.
MIN_FRAME_SPACING_SEC=0.15

# Minimum Laplacian variance for a frame to be considered "sharp".
# Frames below this are flagged is_blurry=true in metadata.json but are
# still KEPT (not discarded) unless they are also a near-duplicate --
# a legitimate side/back view should not be thrown away just for being
# slightly soft.
BLUR_THRESHOLD=100.0

# Mean absolute grayscale pixel difference (0-255 scale) below which a
# candidate frame is treated as a near-duplicate and skipped.
DUPLICATE_THRESHOLD=2.0

# How many of the most-recently-accepted frames a new candidate is
# compared against for near-duplicate detection (a rolling window,
# rather than only the single last accepted frame).
DUPLICATE_WINDOW=3

# ── Human Detection, Segmentation & Pose Estimation (Module 3) ───────────────
# Directory (under each video's capture folder) where pose/segmentation
# outputs are written: data/captures/{video_id}/<this>/
POSE_OUTPUT_DIRNAME=processed_frames

# Local directory where MediaPipe model asset files (.task/.tflite) are
# cached after being downloaded automatically on first use.
MEDIAPIPE_MODEL_DIR=models/mediapipe

# Minimum pose-detection confidence for MediaPipe PoseLandmarker to
# accept a detected pose in a frame.
POSE_MIN_CONFIDENCE=0.5

# Minimum per-landmark visibility score (0-1) for a landmark to be
# counted as "visible" in metadata.json / the review-required logic.
POSE_LANDMARK_VISIBILITY_THRESHOLD=0.5
